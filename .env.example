# InterviewAI Environment Configuration

# Server Config
PORT=8000
HOST=0.0.0.0

# Mock Mode (Set true for offline test mode without LLM API key, false for production)
MOCK_LLM=false

# Unified LLM Provider Settings
LLM_PROVIDER=auto
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# Specific Provider API Keys (Optional - Smart Fallback Engine runs if unconfigured)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Application Settings
ENVIRONMENT=production
LOG_LEVEL=INFO
